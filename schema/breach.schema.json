{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Breach",
  "description": "情報漏洩インシデント1件分のデータ",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "organization",
    "date_announced",
    "cause",
    "summary",
    "sources"
  ],
  "properties": {
    "organization": {
      "type": "string",
      "minLength": 1,
      "description": "漏洩を公表した企業・団体の正式名称"
    },
    "group": {
      "type": "string",
      "minLength": 1,
      "description": "企業グループ名（任意）。同じグループの事案をランキングでまとめて集計する"
    },
    "services": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "description": "影響を受けたサービス・サイト名"
    },
    "industry": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      ],
      "description": "業種。data/industries.yml にある名前のみ使用可。当事者の業種を先頭に、影響を受けた側の業種（委託元の自治体・病院など）も複数指定できる"
    },
    "org_type": {
      "type": "string",
      "pattern": "^[a-z_]+$",
      "description": "民間企業以外の組織の種類。data/org-types.yml の ID（自治体・大学・病院など）"
    },
    "prefecture": {
      "type": "string",
      "minLength": 2,
      "description": "組織の所在地の都道府県。data/prefectures.yml にある名前"
    },
    "country": {
      "type": "string",
      "pattern": "^[A-Z]{2}$",
      "description": "ISO 3166-1 alpha-2 国コード（例: JP）"
    },
    "date_occurred": {
      "type": "string",
      "format": "date",
      "description": "発生日（判明している場合）YYYY-MM-DD"
    },
    "date_announced": {
      "type": "string",
      "format": "date",
      "description": "最初の公表日 YYYY-MM-DD"
    },
    "status": {
      "type": "string",
      "enum": [
        "investigating"
      ],
      "description": "investigating: 企業が件数・漏えいの有無などを調査中と公表している。サイトに「企業側が調査中」と表示し、issue で続報を募集する"
    },
    "reliability": {
      "type": "string",
      "enum": [
        "low"
      ],
      "description": "low: 公式発表や信頼できる報道（一次情報）を確認できていない（まとめサイトにしか載っていないなど）。サイトに信頼度「低」と表示し、issue で情報を募集する。高・中は出典から自動で判定する"
    },
    "leaked": {
      "type": "boolean",
      "enum": [
        false
      ],
      "description": "false: 不正アクセスなどを受けたが、調査の結果、情報が閲覧・持ち出された形跡は確認されなかったと公表している。サイトに「お漏らし無し」と表示し、漏洩件数の合計・ランキング・地図などの集計から外す（「お漏らししなかったランキング」で数える）"
    },
    "issue": {
      "type": "string",
      "pattern": "^https://github\\.com/n0bisuke/haveibeenmorasareta/issues/[0-9]+$",
      "description": "情報募集用の Issue の URL（status: investigating または reliability: low のとき）"
    },
    "affected_count": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "description": "漏洩（またはその可能性がある）件数・人数。不明なら null"
    },
    "count_note": {
      "type": "string",
      "description": "件数に関する補足（推計値、最大値など）"
    },
    "cause": {
      "type": "string",
      "enum": [
        "ransomware",
        "unauthorized_access",
        "vulnerability",
        "misconfiguration",
        "phishing",
        "malware",
        "third_party",
        "insider",
        "human_error",
        "lost_device",
        "unknown",
        "other"
      ],
      "description": "主な原因"
    },
    "vuln_target": {
      "type": "string",
      "pattern": "^[a-z_]+$",
      "description": "脆弱性を悪用された箇所。data/vuln-targets.yml の ID"
    },
    "attack_methods": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z_]+$"
      },
      "minItems": 1,
      "uniqueItems": true,
      "description": "判明している攻撃手法。data/attack-methods.yml の ID（複数可）"
    },
    "root_cause": {
      "type": "string",
      "minLength": 4,
      "maxLength": 80,
      "description": "原因の詳細（任意）。悪用された脆弱性や侵入経路など、公表されている範囲で簡潔に"
    },
    "vendor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "description": "漏洩が起きた委託先・提供元（任意）。委託先経由の事案のみ",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "委託先の正式名称"
        },
        "group": {
          "type": "string",
          "minLength": 1,
          "description": "委託先の企業グループ名（例: 日立グループ）。ランキングでまとめて集計する"
        }
      }
    },
    "data_types": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "description": "漏洩した情報の種類（例: 氏名、メールアドレス、パスワード、クレジットカード情報）"
    },
    "summary": {
      "type": "string",
      "minLength": 10,
      "maxLength": 600,
      "description": "概要（事実ベースで簡潔に）"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "description": "出典。できるだけ当事者の公式発表を最初に記載",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://"
          }
        }
      }
    },
    "related": {
      "type": "array",
      "minItems": 1,
      "description": "関連ページ（任意）。出典ではないが事案に関係する公開情報。委託先・開発会社の導入事例など、事案の後に削除されたページはアーカイブ（Wayback Machine など）の URL を載せ、removed: true を付ける",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "url"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://"
          },
          "note": {
            "type": "string",
            "maxLength": 200,
            "description": "事案との関係の説明（推測で関係を断定しない。当事者の説明があれば書く）"
          },
          "removed": {
            "type": "boolean",
            "enum": [
              true
            ],
            "description": "元のページが削除された（url はアーカイブ）"
          }
        }
      }
    }
  }
}
