{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Breach",
  "description": "情報漏洩インシデント1件分のデータ",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "organization",
    "date_announced",
    "cause",
    "summary",
    "sources"
  ],
  "properties": {
    "organization": {
      "type": "string",
      "minLength": 1,
      "description": "漏洩を公表した企業・団体の正式名称"
    },
    "group": {
      "type": "string",
      "minLength": 1,
      "description": "企業グループ名（任意）。同じグループの事案をランキングでまとめて集計する"
    },
    "services": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "description": "影響を受けたサービス・サイト名"
    },
    "industry": {
      "type": "string",
      "description": "業種。data/industries.yml にある名前のみ使用可"
    },
    "country": {
      "type": "string",
      "pattern": "^[A-Z]{2}$",
      "description": "ISO 3166-1 alpha-2 国コード（例: JP）"
    },
    "date_occurred": {
      "type": "string",
      "format": "date",
      "description": "発生日（判明している場合）YYYY-MM-DD"
    },
    "date_announced": {
      "type": "string",
      "format": "date",
      "description": "最初の公表日 YYYY-MM-DD"
    },
    "affected_count": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "description": "漏洩（またはその可能性がある）件数・人数。不明なら null"
    },
    "count_note": {
      "type": "string",
      "description": "件数に関する補足（推計値、最大値など）"
    },
    "cause": {
      "type": "string",
      "enum": [
        "ransomware",
        "unauthorized_access",
        "vulnerability",
        "misconfiguration",
        "phishing",
        "malware",
        "third_party",
        "insider",
        "human_error",
        "lost_device",
        "unknown",
        "other"
      ],
      "description": "主な原因"
    },
    "data_types": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "description": "漏洩した情報の種類（例: 氏名、メールアドレス、パスワード、クレジットカード情報）"
    },
    "summary": {
      "type": "string",
      "minLength": 10,
      "maxLength": 600,
      "description": "概要（事実ベースで簡潔に）"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "description": "出典。できるだけ当事者の公式発表を最初に記載",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://"
          }
        }
      }
    }
  }
}
