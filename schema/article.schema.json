{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "読みもの（解説・まとめ・Tips）",
  "description": "data/articles/*.yml の形式。漏洩事案のデータとは別物で、件数・ランキングには含めない",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "date", "kind", "summary", "body", "sources"],
  "properties": {
    "title": { "type": "string", "minLength": 5, "maxLength": 80, "description": "見出し" },
    "date": { "type": "string", "format": "date", "description": "公開日（YYYY-MM-DD）。ファイル名の年月と一致させる" },
    "updated": { "type": "string", "format": "date", "description": "更新日（任意）" },
    "kind": { "type": "string", "enum": ["解説", "まとめ", "Tips"], "description": "Tips は一覧の上段（今すぐできる Tips）に出る" },
    "tags": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 20 }, "uniqueItems": true, "maxItems": 6 },
    "summary": { "type": "string", "minLength": 10, "maxLength": 200, "description": "一覧に出す要約" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": { "type": "string", "minLength": 2, "maxLength": 60 },
      "description": "Tips の要点（一覧のカードに番号付きで出す）"
    },
    "body": { "type": "string", "minLength": 50, "description": "本文。簡易 Markdown（## 見出し、- 箇条書き、1. 番号付き、**太字**、[リンク](https://…)）" },
    "related": {
      "type": "array",
      "items": { "type": "string", "pattern": "^\\d{4}-\\d{2}-[a-z0-9]+(?:-[a-z0-9]+)*$" },
      "uniqueItems": true,
      "description": "関連する事案の ID（data/breaches のファイル名から .yml を除いたもの）"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url"],
        "properties": {
          "title": { "type": "string" },
          "url": { "type": "string", "format": "uri", "pattern": "^https?://" }
        }
      }
    }
  }
}
